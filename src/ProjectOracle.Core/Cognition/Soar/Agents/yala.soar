# A normal statement deliberately produces a tie. Yala resolves it in a substate
# rather than receiving a hard-wired answer from the host program.
sp {yala*propose*contact*statement*acknowledge
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement)
-->
   (<s> ^operator <o> +)
   (<o> ^name acknowledge-statement)
}

sp {yala*propose*contact*statement*clarify
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement)
-->
   (<s> ^operator <o> +)
   (<o> ^name ask-clarification)
}

sp {yala*substate*resolve-statement
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <ack> + <clarify> +)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement ^ambiguous no)
   (<ack> ^name acknowledge-statement)
   (<clarify> ^name ask-clarification)
-->
   (<s> ^operator <ack> > <clarify>)
}

sp {yala*substate*resolve-ambiguous-statement
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <ack> + <clarify> +)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement ^ambiguous yes)
   (<ack> ^name acknowledge-statement)
   (<clarify> ^name ask-clarification)
-->
   (<s> ^operator <clarify> > <ack>)
}

sp {yala*propose*contact*ambiguous
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act ambiguous)
-->
   (<s> ^operator <o> +)
   (<o> ^name ask-clarification)
}

