# Project Oracle v0.0.19 - Yala Soar Brain Slice 3
# Yala receives only in-world perception and remembered/learned state.
# There is deliberately no Oracle fact, identity, attribute, operator, or hidden-system name.

# -----------------------------
# Direct-contact proposal rules
# -----------------------------

sp {yala*propose*contact*introduction-new
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act introduction ^known-contact no ^asks-remember no)
-->
   (<s> ^operator <o> +)
   (<o> ^name acknowledge-introduction-new)
}

sp {yala*propose*contact*introduction-known
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act introduction ^known-contact yes ^asks-remember no)
-->
   (<s> ^operator <o> +)
   (<o> ^name acknowledge-introduction-known)
}

