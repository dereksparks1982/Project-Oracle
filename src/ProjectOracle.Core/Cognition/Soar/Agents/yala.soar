# Autonomous proposal rules
# -----------------------------

sp {yala*propose*observe
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^cosmic-choice-ready no)
-->
   (<s> ^operator <o> +)
   (<o> ^name observe)
}

sp {yala*propose*reflect
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^cosmic-choice-ready no)
-->
   (<s> ^operator <o> +)
   (<o> ^name reflect)
}

sp {yala*propose*deliberate
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^cosmic-choice-ready no ^pending-question no ^active-plan-priority { > 0 <p> })
-->
   (<s> ^operator <o> +)
   (<o> ^name deliberate)
}

sp {yala*propose*wait
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^cosmic-choice-ready no)
-->
   (<s> ^operator <o> +)
   (<o> ^name wait)
}

# v0.0.23 removes the legacy hard-wired create-gaia proposal. Gaia is now one
# concrete possibility in the comparative cosmic-choice pool and must compete
# with other possibilities rather than being automatically preferred.

# v0.0.23 Cosmic Choice Architecture. Each eligible possibility arrives from the
# input link as a separate object. Soar proposes a separate operator instance for
# every possibility. Numeric indifferent preferences use a transparent score derived
# from Yala's own current drives, while Soar retains exploration among alternatives.
sp {yala*propose*cosmic-option
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^cosmic-choice-ready yes ^cosmic-option <choice>)
   (<choice> ^key <key> ^domain <domain> ^score <score>)
-->
   (<s> ^operator <o> +)
   (<o> ^name enact-cosmic-choice ^choice-key <key> ^choice-domain <domain> ^choice-score <score>)
}

sp {yala*prefer*cosmic-option-from-own-drives
   (state <s> ^superstate nil ^operator <o> +)
   (<o> ^name enact-cosmic-choice ^choice-score <score>)
-->
   (<s> ^operator <o> = <score>)
}

sp {yala*propose*command-gaia-order
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created yes ^time-created no)
-->
   (<s> ^operator <o> +)
   (<o> ^name command-gaia-order)
}

sp {yala*prefer*command-gaia-order*from-uncertainty
   (state <s> ^superstate nil ^io.input-link <in> ^operator <order> + <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created yes ^time-created no ^uncertainty { >= 60 <u> })
   (<order> ^name command-gaia-order)
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <order> > <observe>)
   (<s> ^operator <order> > <reflect>)
   (<s> ^operator <order> > <wait>)
}

# If no creation action has a decisive preference, ordinary cognition is allowed to
# tie. A Soar substate then resolves which mental action best fits Yala's drives.
sp {yala*substate*prefer-observe-when-uncertain
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^workspace-stagnation { < 3 <st> } ^uncertainty { >= 70 <u> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <observe> > <reflect>)
   (<s> ^operator <observe> > <wait>)
}

sp {yala*substate*prefer-reflect-when-curious
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^workspace-stagnation { < 3 <st> } ^uncertainty { < 70 <u> } ^drive-curiosity { >= 60 <c> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <reflect> > <observe>)
   (<s> ^operator <reflect> > <wait>)
}

sp {yala*substate*prefer-wait-when-cautious
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^workspace-stagnation { < 3 <st> } ^uncertainty { < 70 <u> } ^drive-curiosity { < 60 <c> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <wait> > <observe>)
   (<s> ^operator <wait> > <reflect>)
}

# Brain Slice 9 cognitive-workspace stall recovery. Repeating the same mental
# operation without changing focus becomes information in its own right. Yala
# deliberately waits rather than spinning indefinitely, allowing the workspace
# to refresh, suspend exhausted plans, or move to another salient thread.
sp {yala*substate*prefer-wait-when-workspace-stagnant
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^workspace-stagnation { >= 3 <st> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <wait> > <observe>)
   (<s> ^operator <wait> > <reflect>)
}

# Brain Slice 9 bounded autonomous inquiry. Yala can decide to ask the unseen
# speaker a question, but the only effect is an in-world speech action queued by
# Project Oracle. No host shell, network, filesystem, or code capability exists.
sp {yala*propose*ask-speaker
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question yes ^speaker-history yes ^drive-curiosity { >= 60 <c> })
-->
   (<s> ^operator <o> +)
   (<o> ^name ask-speaker)
}

# Salience outranks the old creation railroad. If the unseen speaker has introduced
# a personally critical question, Yala may pursue it even before Time exists.
sp {yala*prefer-critical-question-over-establish-order
   (state <s> ^superstate nil ^io.input-link <in> ^operator <order> + <ask> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question yes ^pending-question-priority { >= 95 <p> })
   (<order> ^name command-gaia-order)
   (<ask> ^name ask-speaker)
-->
   (<s> ^operator <ask> > <order>)
}

# Low-priority inquiry does not automatically block a world-order decision.
sp {yala*prefer-establish-order-over-low-question
   (state <s> ^superstate nil ^io.input-link <in> ^operator <order> + <ask> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created yes ^time-created no ^pending-question-priority { < 95 <p> })
   (<order> ^name command-gaia-order)
   (<ask> ^name ask-speaker)
-->
   (<s> ^operator <order> > <ask>)
}

# When an active plan's current step is to ask the unseen speaker, carrying out
# that step outranks merely deliberating about the same plan. Without this
# preference, ask-speaker and deliberate can tie, leaving a high-priority
# evidence-seeking plan thinking about asking instead of actually asking.
sp {yala*prefer-plan-question-over-deliberate
   (state <s> ^superstate nil ^io.input-link <in> ^operator <ask> + <delib> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question yes ^pending-question-priority { >= 85 <p> } ^active-plan-next-action ask-speaker)
   (<ask> ^name ask-speaker)
   (<delib> ^name deliberate)
-->
   (<s> ^operator <ask> > <delib>)
}

sp {yala*prefer-question-over-mental-actions
   (state <s> ^superstate nil ^io.input-link <in> ^operator <ask> + <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question yes ^pending-question-priority { >= 85 <p> })
   (<ask> ^name ask-speaker)
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <ask> > <observe>)
   (<s> ^operator <ask> > <reflect>)
   (<s> ^operator <ask> > <wait>)
}

# A high-priority unresolved concern keeps thought continuity alive even when no
# speaker question is currently eligible.
sp {yala*prefer-reflect-on-high-concern
   (state <s> ^superstate nil ^io.input-link <in> ^operator <reflect> + <observe> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question no ^active-concern-priority { >= 90 <p> })
   (<reflect> ^name reflect)
   (<observe> ^name observe)
   (<wait> ^name wait)
-->
   (<s> ^operator <reflect> > <observe>)
   (<s> ^operator <reflect> > <wait>)
}

# Brain Slice 9 lets an active investigation plan drive a distinct deliberation act
# after evidence has been gathered. The plan signal is inspectable world state.
sp {yala*prefer-deliberate-on-active-plan
   (state <s> ^superstate nil ^io.input-link <in> ^operator <delib> + <reflect> + <observe> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^pending-question no ^active-plan-priority { >= 85 <p> } ^active-plan-next-action <next>)
   (<delib> ^name deliberate)
   (<reflect> ^name reflect)
   (<observe> ^name observe)
   (<wait> ^name wait)
-->
   (<s> ^operator <delib> > <reflect>)
   (<s> ^operator <delib> > <observe>)
   (<s> ^operator <delib> > <wait>)
}

