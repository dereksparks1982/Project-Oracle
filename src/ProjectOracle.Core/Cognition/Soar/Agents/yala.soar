# A normal statement deliberately produces a tie. Yala resolves it in a substate
# rather than receiving a hard-wired answer from the host program.
sp {yala*propose*contact*statement*acknowledge
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement)
-->
   (<s> ^operator <o> +)
   (<o> ^name acknowledge-statement)
}

sp {yala*propose*contact*statement*clarify
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement)
-->
   (<s> ^operator <o> +)
   (<o> ^name ask-clarification)
}

sp {yala*substate*resolve-statement
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <ack> + <clarify> +)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement ^ambiguous no)
   (<ack> ^name acknowledge-statement)
   (<clarify> ^name ask-clarification)
-->
   (<s> ^operator <ack> > <clarify>)
}

sp {yala*substate*resolve-ambiguous-statement
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <ack> + <clarify> +)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act statement ^ambiguous yes)
   (<ack> ^name acknowledge-statement)
   (<clarify> ^name ask-clarification)
-->
   (<s> ^operator <clarify> > <ack>)
}

sp {yala*propose*contact*ambiguous
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact yes ^speech-act ambiguous)
-->
   (<s> ^operator <o> +)
   (<o> ^name ask-clarification)
}

# -----------------------------
# Autonomous proposal rules
# -----------------------------

sp {yala*propose*observe
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no)
-->
   (<s> ^operator <o> +)
   (<o> ^name observe)
}

sp {yala*propose*reflect
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no)
-->
   (<s> ^operator <o> +)
   (<o> ^name reflect)
}

sp {yala*propose*wait
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no)
-->
   (<s> ^operator <o> +)
   (<o> ^name wait)
}

sp {yala*propose*create-gaia
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created no)
-->
   (<s> ^operator <o> +)
   (<o> ^name create-gaia)
}

sp {yala*prefer*create-gaia*from-authority-and-comfort
   (state <s> ^superstate nil ^io.input-link <in> ^operator <create> + <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created no ^drive-authority { >= 60 <a> } ^drive-comfort { >= 55 <c> })
   (<create> ^name create-gaia)
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <create> > <observe>)
   (<s> ^operator <create> > <reflect>)
   (<s> ^operator <create> > <wait>)
}

sp {yala*propose*command-gaia-time
   (state <s> ^superstate nil ^io.input-link <in>)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created yes ^time-created no)
-->
   (<s> ^operator <o> +)
   (<o> ^name command-gaia-time)
}

sp {yala*prefer*command-gaia-time*from-uncertainty
   (state <s> ^superstate nil ^io.input-link <in> ^operator <time> + <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^gaia-created yes ^time-created no ^uncertainty { >= 60 <u> })
   (<time> ^name command-gaia-time)
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <time> > <observe>)
   (<s> ^operator <time> > <reflect>)
   (<s> ^operator <time> > <wait>)
}

# If no creation action has a decisive preference, ordinary cognition is allowed to
# tie. A Soar substate then resolves which mental action best fits Yala's drives.
sp {yala*substate*prefer-observe-when-uncertain
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^uncertainty { >= 70 <u> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <observe> > <reflect>)
   (<s> ^operator <observe> > <wait>)
}

sp {yala*substate*prefer-reflect-when-curious
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^uncertainty { < 70 <u> } ^drive-curiosity { >= 60 <c> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <reflect> > <observe>)
   (<s> ^operator <reflect> > <wait>)
}

sp {yala*substate*prefer-wait-when-cautious
   (state <sub> ^superstate <s> ^impasse tie)
   (<s> ^io.input-link <in> ^operator <observe> + <reflect> + <wait> +)
   (<in> ^world-input <w>)
   (<w> ^contact no ^uncertainty { < 70 <u> } ^drive-curiosity { < 60 <c> })
   (<observe> ^name observe)
   (<reflect> ^name reflect)
   (<wait> ^name wait)
-->
   (<s> ^operator <wait> > <observe>)
   (<s> ^operator <wait> > <reflect>)
}

# -----------------------------
# Application / output rules
# -----------------------------

sp {yala*apply*introduction-new
   (state <s> ^operator <o> ^io.output-link <out>)
   (<o> ^name acknowledge-introduction-new)
-->
   (<out> ^yala-action <cmd>)
   (<cmd> ^name respond ^reply-code introduction-new ^deliberation direct)
}

